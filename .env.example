OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:latest
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_VISION_MODEL=qwen3-vl:8b
OLLAMA_VISION_TIMEOUT_SECONDS=300
OLLAMA_STRUCTURED_MAX_ATTEMPTS=2
OLLAMA_NUM_CTX=16384
OLLAMA_NUM_PREDICT=1536
OLLAMA_VISION_NUM_CTX=8192
# 图表视觉观察的 JSON 输出预算：512 常在 summary+列表写到一半时被截断导致整篇分析失败
OLLAMA_VISION_NUM_PREDICT=2048
VISUAL_ANALYSIS_CONCURRENCY=2
PAPER_ANALYSIS_CONCURRENCY=2
PAPER_ANALYSIS_SECTION_TOKENS=4096
PAPER_ANALYSIS_EXPERIMENT_TOKENS=1536
PAPER_ANALYSIS_OVERVIEW_TOKENS=768

OPENALEX_BASE_URL=https://api.openalex.org
OPENALEX_API_KEY=replace-with-your-free-openalex-api-key
OPENALEX_TIMEOUT_SECONDS=30
OPENALEX_MAX_ATTEMPTS=3
OPENALEX_BACKOFF_SECONDS=0.5
CROSSREF_BASE_URL=https://api.crossref.org
ARXIV_BASE_URL=https://export.arxiv.org/api/query
LITERATURE_TIMEOUT_SECONDS=30
LITERATURE_CACHE_TTL_SECONDS=900

RANKING_LLM_TOP_N=10
RANKING_ABSTRACT_CHARS=600

DATABASE_PATH=data/research_pilot.db
SKILLS_ROOT=skills
SKILL_MAX_BYTES=64000
WORKSPACE_ROOT=data/workspaces
DOCUMENT_MAX_BYTES=50000000
PDF_RENDER_DPI=200
OCR_LANGUAGES=eng
RESOURCE_TOKEN_SECRET=replace-with-a-long-random-secret
LANGGRAPH_STRICT_MSGPACK=true
MCP_CONFIG_PATH=config/mcp_servers.json

# --- 独立 MCP Server 的 HTTP 鉴权（researchpilot-mcp --transport http）---
# 模式 none/static/github，见 mcp_servers/oauth.py 与 docs/MCP_OAUTH.md
# CLI 启动时会自动加载项目根目录 .env（已存在则覆盖同名项留空处理），
# 因此以下密钥直接写入 .env 即可，无需每次 export：
# static：预共享 Bearer Token（非回环绑定默认要求）
# MCP_AUTH_TOKEN=replace-with-a-long-random-token
# github：OAuth 2.1 授权码 + PKCE，经 GitHub OAuth App 代理（--auth github）
# MCP_GITHUB_CLIENT_ID=
# MCP_GITHUB_CLIENT_SECRET=
# 本端点公网可访问的 base URL（或命令行 --public-base-url）；GitHub App 回调 =
# {base}/auth/callback。回环开发可 http://localhost:端口
# MCP_OAUTH_BASE_URL=http://localhost:8102
# 本地开发可关闭授权确认页（生产保持 True）：0/false/no 关闭
# MCP_OAUTH_REQUIRE_CONSENT=1
# 可选：FastMCP 签发 JWT 的签名密钥（缺省由 client secret 派生）
# MCP_OAUTH_JWT_SIGNING_KEY=
# OAuth 状态（客户端注册/refresh token）加密存储目录，默认 <项目根>/data/oauth-proxy
# MCP_OAUTH_DATA_DIR=
