{
  "version": 1,
  "servers": [
    {
      "id": "external-arxiv",
      "source": "third_party",
      "transport": "stdio",
      "enabled": true,
      "command": "uvx",
      "args": ["arxiv-mcp-server==0.7.2"],
      "timeout_seconds": 45,
      "capabilities": {
        "literature.search.arxiv": {"tool": "search_papers", "priority": 10},
        "literature.metadata.arxiv": {"tool": "get_abstract", "priority": 10},
        "paper.download.arxiv": {"tool": "download_paper", "priority": 10},
        "paper.outline.arxiv": {"tool": "get_paper_outline", "priority": 10},
        "paper.section.arxiv": {"tool": "read_paper_section", "priority": 10}
      }
    },
    {
      "id": "researchpilot-literature",
      "source": "researchpilot",
      "transport": "inprocess",
      "enabled": true,
      "timeout_seconds": 60,
      "capabilities": {
        "literature.search.multisource": {"tool": "search_papers", "priority": 20},
        "literature.search.arxiv": {"tool": "search_papers", "priority": 100},
        "literature.metadata": {"tool": "get_paper_metadata", "priority": 20}
      }
    },
    {
      "id": "researchpilot-document",
      "source": "researchpilot",
      "transport": "inprocess",
      "enabled": true,
      "timeout_seconds": 300,
      "capabilities": {
        "paper.ingest": {"tool": "submit_paper", "priority": 20},
        "paper.parse": {"tool": "parse_document", "priority": 20},
        "paper.analyze": {"tool": "start_paper_analysis", "priority": 20},
        "paper.structure": {"tool": "get_paper_structure", "priority": 20},
        "paper.evidence": {"tool": "get_paper_evidence", "priority": 20},
        "paper.method_card": {"tool": "get_method_card", "priority": 20},
        "paper.summary": {"tool": "get_paper_summary", "priority": 20}
      }
    },
    {
      "id": "researchpilot-artifact",
      "source": "researchpilot",
      "transport": "inprocess",
      "enabled": true,
      "timeout_seconds": 60,
      "capabilities": {
        "artifact.markdown": {"tool": "create_markdown", "priority": 20},
        "artifact.csv": {"tool": "create_csv", "priority": 20},
        "artifact.mermaid": {"tool": "create_mermaid", "priority": 20}
      }
    }
  ]
}
